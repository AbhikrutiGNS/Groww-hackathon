# ==========================================
# Backend Environment Variables (FastAPI)
# ==========================================

# App DB connection — pooled (Transaction pooler, port 6543)
DATABASE_URL=postgresql+asyncpg://postgres.<your_project_ref>:<your_db_password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
USE_PGBOUNCER=true

# Migrations — pooled, SESSION mode (port 5432), not the direct db.<ref>.supabase.co
# host. That direct host is IPv6-only in most regions and fails to resolve
# (getaddrinfo failed) on IPv4-only networks. The pooler host below resolves
# over IPv4, and session mode (unlike the transaction-mode pooler above)
# supports the advisory lock Alembic needs.
ALEMBIC_DATABASE_URL=postgresql+asyncpg://postgres.<your_project_ref>:<your_db_password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

CORS_ALLOWED_ORIGINS=http://localhost:3000
INGESTION_INTERVAL_SECONDS=60
SQL_ECHO=false

# --- Auth ---
# app/auth.py reads JWT_SECRET_KEY specifically — not JWT_SECRET. The name
# had drifted, which meant the app was silently using the insecure hardcoded
# fallback ("dev-only-insecure-secret-change-me") instead of this value.
JWT_SECRET_KEY=your_super_secret_jwt_key_here
JWT_EXPIRE_MINUTES=60

# --- Demo mode ---
# Uncomment both for the live demo. Also comment out the
# INGESTION_INTERVAL_SECONDS=60 line above if you do — dotenv takes the
# LAST value it sees for a duplicate key within the same file, so leaving
# both active works (3600 wins), but it's clearer to just swap them.
# DEMO_MODE=1
# INGESTION_INTERVAL_SECONDS=3600

# ==========================================
# Frontend Environment Variables (Next.js)
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:8000
